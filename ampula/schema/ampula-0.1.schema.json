{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ampula.dev/schema/ampula-0.1.schema.json",
  "title": "Ámpula 0.1",
  "description": "A transferable memory of a moment through music.",
  "type": "object",
  "required": ["format", "version", "capturedAt", "tracks"],
  "additionalProperties": true,
  "properties": {
    "format": { "const": "ampula" },
    "version": { "const": "0.1" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "moment": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string", "maxLength": 240 },
        "note": { "type": "string", "maxLength": 4000 }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/track" }
    }
  },
  "$defs": {
    "track": {
      "type": "object",
      "required": ["title", "artists"],
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "artists": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "album": { "type": "string" },
        "versionLabel": { "type": "string" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "isrc": { "type": "string" },
        "musicBrainzRecordingId": { "type": "string" },
        "fingerprint": {
          "type": "object",
          "required": ["algorithm", "value"],
          "additionalProperties": true,
          "properties": {
            "algorithm": { "type": "string", "minLength": 1 },
            "value": { "type": "string", "minLength": 1 }
          }
        },
        "cue": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "startMs": { "type": "integer", "minimum": 0 },
            "endMs": { "type": "integer", "minimum": 0 }
          }
        },
        "observations": {
          "type": "array",
          "items": { "$ref": "#/$defs/observation" }
        }
      }
    },
    "observation": {
      "type": "object",
      "required": ["service", "observedAt"],
      "additionalProperties": true,
      "properties": {
        "service": { "type": "string", "minLength": 1 },
        "itemId": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "observedAt": { "type": "string", "format": "date-time" },
        "representation": { "type": "string" }
      },
      "anyOf": [
        { "required": ["itemId"] },
        { "required": ["url"] }
      ]
    }
  }
}
